---
import { navLinks, site } from "../data/site";

const year = new Date().getFullYear();
---
<footer class="footer tone-alt">
  <div class="wrap footer-inner">
    <ul class="footer-links">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={site.github} rel="me noopener">GitHub</a></li>
      <li><!--email_off--><a href={`mailto:${site.email}`}>Email</a><!--/email_off--></li>
    </ul>
    <p class="footer-legal">© {year} {site.name}. {site.location.city}, India.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
  }
</style>
