---
// Light/dark switch. The site follows the system preference until the visitor picks a theme;
// the choice is stored in localStorage and applied before paint by the inline script in BaseLayout.
---
<button type="button" class="theme-toggle" data-theme-toggle data-cta="nav.theme" aria-label="Switch colour theme" aria-pressed="false">
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55"></path>
  </svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.2 14.1A8.3 8.3 0 0 1 9.9 3.8a8.3 8.3 0 1 0 10.3 10.3Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text);
    cursor: pointer;
    opacity: 0.8;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  /* Show the icon for the theme the button switches TO. */
  .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const current = () => root.dataset.theme ?? (media.matches ? "dark" : "light");

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    const sync = () => button.setAttribute("aria-pressed", String(current() === "dark"));
    sync();
    media.addEventListener("change", sync);
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* storage blocked: the choice still applies for this page view */
      }
      sync();
    });
  });
</script>
