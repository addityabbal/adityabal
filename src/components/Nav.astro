---
// Slim translucent sticky navigation.
import { navLinks, site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---
<header class="nav">
  <nav class="wrap nav-inner" aria-label="Main">
    <a class="nav-home" href="/" data-cta="nav.home" aria-current={pathname === "/" ? "page" : undefined}>{site.shortName}</a>
    <ul class="nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} data-cta={`nav.${link.label.toLowerCase()}`} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--nav-height);
    font-size: var(--fs-small);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    opacity: 0.8;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    opacity: 1;
    text-decoration: none;
  }

  .nav-home {
    margin-right: auto;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-heading);
  }

  .nav a.nav-home {
    opacity: 1;
  }

  .nav-links {
    display: flex;
    gap: clamp(var(--space-4), 4vw, var(--space-6));
  }

  .nav-links a[aria-current="page"] {
    font-weight: var(--fw-medium);
  }
</style>
