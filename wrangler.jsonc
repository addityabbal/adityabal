{
	"compatibility_date": "2026-03-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "adityabal",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// ── Live demos (/demos/*, /api/*) ──────────────────────────────────────────
	// Secrets (never in this file): TURNSTILE_SECRET_KEY, SESSION_SECRET
	//   npx wrangler secret put TURNSTILE_SECRET_KEY   (etc.)
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF_O6R3MA5HcxYls",
		"ALLOWED_ORIGINS": "https://adityabal.com,https://www.adityabal.com",
		"YOGA_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
	},
	// Workers AI: free 10,000 neurons/day (~60 neurons per Yoga-Doc request).
	"ai": {
		"binding": "AI"
	},
	// Create once with: npx wrangler d1 create adityabal-demos  (then paste the id below)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "adityabal-demos",
			"database_id": "2ac8d598-bc8b-446e-98dc-7b1b2c4a2f52",
			"migrations_dir": "migrations"
		}
	],
	// 10 requests per IP per minute across demo APIs.
	"ratelimits": [
		{
			"name": "DEMO_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
